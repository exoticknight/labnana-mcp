{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.exoticknight/labnana-mcp",
  "title": "Labnana MCP",
  "description": "Generate and edit images with Labnana through a local MCP server with MCP Apps previews.",
  "repository": {
    "url": "https://github.com/exoticknight/labnana-mcp",
    "source": "github"
  },
  "version": "2.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@exoticknight/labnana-mcp",
      "version": "2.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LABNANA_API_KEY",
          "description": "Labnana API key.",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LABNANA_OUTPUT_DIR",
          "description": "Default directory for saved images.",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
